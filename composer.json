{
    "name": "wazum/rte-ckeditor-no-translate",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "description": "CKEditor 5 button to mark text as not translatable with translate=\"no\"",
    "homepage": "https://github.com/wazum/typo3-rte-ckeditor-no-translate",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Wolfgang Klinger",
            "email": "wolfgang@wazum.com",
            "role": "Lead Developer"
        }
    ],
    "keywords": [
        "typo3",
        "ckeditor",
        "rte",
        "translate",
        "notranslate",
        "translation",
        "deepl"
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-rte-ckeditor": "^13.4 || ^14.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "typo3/testing-framework": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Wazum\\RteCkeditorNoTranslate\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wazum\\RteCkeditorNoTranslate\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "rte_ckeditor_no_translate",
            "version": "1.0.0",
            "web-dir": ".Build/Web",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "scripts": {
        "test:functional": "phpunit -c phpunit-functional.xml"
    }
}
